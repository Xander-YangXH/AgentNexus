# 复制为 .env 后按需修改：cp .env.template .env
# .env 已加入 .gitignore，不要提交真实密码

# --- Postgres ---
POSTGRES_USER=agentnexus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentnexus

# --- 宿主机端口（只绑定 127.0.0.1）---
API_PORT=8000
WEB_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- 执行器（可选，括号内为默认值）---
# WORKER_CONCURRENCY=4        # 同时执行的 run 数
# RUN_TIMEOUT_SECONDS=300     # 单个 run 超时
# SWEEP_INTERVAL_SECONDS=5                 # 空闲时多久查一次待执行 / 租约过期的任务（有通知时立即唤醒）
# JOB_LEASE_SECONDS=30                     # 任务租约（decisions/0020）：worker 失联多久后任务被别人接管
# JOB_HEARTBEAT_SECONDS=10                 # 续约间隔，取租约的 1/3
# RUN_MAX_ATTEMPTS=3                       # 一个 run 最多执行几次（含接管），超过标为 interrupted
# CHECKPOINT_RETENTION_HOURS=24            # run 结束后 LangGraph checkpoint 保留多久再清理
# CHECKPOINT_JANITOR_INTERVAL_SECONDS=600  # 多久检查一次待清理的 checkpoint
# LOG_LEVEL=INFO                           # DEBUG 时会看到健康检查等低价值请求
# LOG_FORMAT=text                          # text 给人看；json 一行一个 JSON，给日志平台用
# MAX_UPLOAD_MB=10                         # 知识库单个文件大小上限
# INGEST_CONCURRENCY=1                     # 同时处理（向量化）的文档数；CPU 密集，一般不用调
# EMBEDDING_THREADS=                       # 向量化线程数，默认用满所有核；设小（如 4）可让入库期间的检索快约 1/4，但入库慢 35%~90%
# QDRANT_PORT=6333                         # Qdrant 映射到宿主机的端口（只绑 127.0.0.1）
# RERANK_ENABLED=true                      # 检索时是否重排；关掉不加载重排模型，省约 0.8GB 内存
# RERANK_CANDIDATES=10                     # 交给重排的候选数；10 个约 1 秒（CPU），近似线性
# KNOWLEDGE_PREFETCH=true                 # 回答前先用用户原话检索一次（评测：引用正确 1.00、模型调用减半）；false 则完全由模型决定
# KNOWLEDGE_TOP_K=4                        # 每次检索给模型几个片段；越多越全，但输入 token 越多

# --- 知识图谱（decisions/0019）---
NEO4J_PASSWORD=change-me-neo4j           # 必填，至少 8 位
# KG_MAX_CHUNKS_PER_BUILD=2000             # 单次构建最多抽取的分块数（去重后），防止误点花掉一大笔钱

# --- LLM（默认 fake：确定性回声模型，不需要密钥）---
# 换成真实模型：
#   LLM_PROVIDER=openai        # openai = 任意 OpenAI 兼容接口（DeepSeek、通义、智谱等，用 LLM_BASE_URL 指定）
#   LLM_MODEL=your-model-name
#   LLM_API_KEY=sk-...         # 只写在本机 .env，不要提交
#   LLM_BASE_URL=https://api.example.com/v1
# 或 LLM_PROVIDER=anthropic + LLM_MODEL + LLM_API_KEY（LLM_BASE_URL 可指向 Anthropic 兼容接口）
# DeepSeek（两种格式价格相同，模型 ID 用 deepseek-flash，不是展示名 DeepSeek-V4.1-Flash-1017）：
#   OpenAI 格式：   LLM_PROVIDER=openai     LLM_BASE_URL=https://api.deepseek.com
#   Anthropic 格式：LLM_PROVIDER=anthropic  LLM_BASE_URL=https://api.deepseek.com/anthropic（推荐：思考内容以内容块保留）
# 思考模式（仅 openai / anthropic 分支）：不设置 = 供应商默认（DeepSeek 默认开启、强度高）
#   思考 token 按输出计费，普通聊天建议关闭以省钱：
# LLM_THINKING=disabled
# 或 Gemini：LLM_PROVIDER=google + LLM_MODEL=<模型名> + LLM_API_KEY=<AI Studio 的 key>（不需要 LLM_BASE_URL）
LLM_PROVIDER=fake
# 假模型逐块输出的间隔（秒）。设成 0.1 左右可以在页面上看清流式效果，不消耗任何 API 额度
# LLM_FAKE_STREAM_DELAY=0

# --- 工具与沙盒（decisions/0021）---
# worker 调用 sandbox 服务的令牌，必填，至少 16 位。生成：python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
SANDBOX_TOKEN=change-me-to-a-long-random-token
# SANDBOX_EXEC_TIMEOUT=30                  # 单次 python_exec 最多运行几秒
# SANDBOX_MEMORY=256m                      # 每个沙盒容器的内存上限（禁用 swap）
# SANDBOX_CPUS=0.5                         # 每个沙盒容器的 CPU 上限
# SANDBOX_CONCURRENCY=4                    # sandbox 服务同时运行的容器数
# MCP_CALL_TIMEOUT=60                      # MCP 网关单次工具调用的超时（秒）
# AGENT_MAX_TOOL_ROUNDS=8                  # 加载技能后一次回答最多几轮工具调用

# --- 深度调研（decisions/0022）---
# RESEARCH_TIMEOUT_SECONDS=900             # 调研 run 单次执行的超时（不含等待审批）
# RESEARCH_MAX_SUBTASKS=5                  # 计划最多几个子任务
# RESEARCH_CONCURRENCY=3                   # 同时调用模型的子 Agent 数
# APPROVAL_TTL_HOURS=24                    # 等待审批多久后自动取消

# --- 登录与数据库角色（decisions/0023）---
# api / worker 连接数据库用的角色密码（migrate 服务会创建这两个角色并授权）。生成：python3 -c 'import secrets;print(secrets.token_urlsafe(24))'
DB_API_PASSWORD=change-me-api
DB_WORKER_PASSWORD=change-me-worker
# SESSION_TTL_HOURS=168                    # 登录会话有效期
# COOKIE_SECURE=false                      # 部署在 HTTPS 后面时改为 true
# 创建第一个管理员（密码从环境变量读，不进 shell 历史）：
#   docker compose exec -e PW='<密码>' api python -m agentnexus.cli create-user --name admin --role admin --password-env PW
