# 复制为 .env 后按需修改：cp .env.template .env
# .env 已加入 .gitignore，不要提交真实密码

# --- Postgres ---
POSTGRES_USER=agentnexus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentnexus

# --- 宿主机端口（只绑定 127.0.0.1）---
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- 执行器（可选，括号内为默认值）---
# WORKER_CONCURRENCY=4        # 同时执行的 run 数
# RUN_TIMEOUT_SECONDS=300     # 单个 run 超时
# SWEEP_INTERVAL_SECONDS=5    # 扫描 queued 补投递的间隔

# --- LLM（默认 fake：确定性回声模型，不需要密钥）---
# 换成真实模型：
#   LLM_PROVIDER=openai        # openai = 任意 OpenAI 兼容接口（DeepSeek、通义、智谱等，用 LLM_BASE_URL 指定）
#   LLM_MODEL=your-model-name
#   LLM_API_KEY=sk-...         # 只写在本机 .env，不要提交
#   LLM_BASE_URL=https://api.example.com/v1
# 或 LLM_PROVIDER=anthropic + LLM_MODEL + LLM_API_KEY
# 或 Gemini：LLM_PROVIDER=google + LLM_MODEL=<模型名> + LLM_API_KEY=<AI Studio 的 key>（不需要 LLM_BASE_URL）
LLM_PROVIDER=fake
